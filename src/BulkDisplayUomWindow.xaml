<Window x:Class="Obozny.BulkDisplayUomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Альтернативні одиниці виміру"
        Width="1100" MinWidth="860"
        Height="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Window.Resources>
        <!-- У клітинці лише сітка DataGrid — без власної рамки Combo/TextBox. -->
        <Style x:Key="CellFlatCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="CellFlatTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Закрити" Style="{StaticResource GhostButton}"
                    MinWidth="140" MinHeight="44" Margin="0,0,8,0" Click="CloseClick"/>
            <Button Content="Зберегти" MinWidth="140" MinHeight="44" Click="SaveClick"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Style="{StaticResource CopyText}"
                     Text="Альтернативні одиниці виміру"
                     FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Muted}"
                       Text="Увесь список номенклатури. Альтернативні одиниці виміру — як на картці (список / «+ Додати О.В.»). Коефіцієнт — введення в клітинку. Сортування кліком по заголовку; фільтр — у рядку над таблицею, строго над своїм стовпчиком. «Зберегти» записує поля картки; «Закрити» — без змін."/>
            <TextBlock x:Name="SummaryText" FontSize="14" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Background="{DynamicResource CardBg}" Padding="4" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Ширини синхронізуються з ActualWidth колонок DataGrid (+ жолоб під V-скрол). -->
                <Grid x:Name="FilterGrid" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="FilterGutterCol" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilterName" MinHeight="40" FontSize="14"
                             ToolTip="Фільтр: назва" TextChanged="FilterChanged"/>
                    <TextBox x:Name="FilterVyd" Grid.Column="1" MinHeight="40" FontSize="14"
                             ToolTip="Фільтр: вид" TextChanged="FilterChanged"/>
                    <TextBox x:Name="FilterUnit" Grid.Column="2" MinHeight="40" FontSize="14"
                             ToolTip="Фільтр: базова О.В." TextChanged="FilterChanged"/>
                    <TextBox x:Name="FilterDisplay" Grid.Column="3" MinHeight="40" FontSize="14"
                             ToolTip="Фільтр: альтернативні одиниці виміру" TextChanged="FilterChanged"/>
                    <TextBox x:Name="FilterFactor" Grid.Column="4" MinHeight="40" FontSize="14"
                             ToolTip="Фільтр: коефіцієнт" TextChanged="FilterChanged"/>
                </Grid>

                <DataGrid x:Name="RowsGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Item"
                          ScrollViewer.CanContentScroll="True"
                          MinRowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Name}"
                                            SortMemberPath="Name" Width="3*" IsReadOnly="True"
                                            ElementStyle="{StaticResource CellLeft}"/>
                        <DataGridTextColumn Header="Вид" Binding="{Binding VydText}"
                                            SortMemberPath="VydText" Width="2*" IsReadOnly="True"
                                            ElementStyle="{StaticResource CellLeft}"/>
                        <DataGridTextColumn Header="Базова О.В." Binding="{Binding Unit}"
                                            SortMemberPath="Unit" Width="90" IsReadOnly="True"
                                            ElementStyle="{StaticResource CellCenter}"/>
                        <!-- Combo в CellTemplate; IsReadOnly=True — без edit-mode DataGrid. -->
                        <DataGridTemplateColumn Header="Альтернативні одиниці виміру" Width="200"
                                                SortMemberPath="SelectedDisplayUnit" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource CellFlatCombo}"
                                              ItemsSource="{Binding DisplayChoices}"
                                              SelectedItem="{Binding SelectedDisplayUnit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              IsSynchronizedWithCurrentItem="False"
                                              ToolTip="Альтернативні одиниці виміру (як на картці). «+ Додати О.В.» — нова для виду."
                                              SelectionChanged="DisplayUnitComboChanged"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Коефіцієнт" Width="120"
                                                SortMemberPath="FactorSortKey" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource CellFlatTextBox}"
                                             Text="{Binding FactorText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             ToolTip="Скільки одиниць відображення в 1 офіційній О.В. Порожньо — не рахувати у зведенні."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
