<Window x:Class="Obozny.NomenclatureCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Картка номенклатури"
        Width="560" MinWidth="480"
        SizeToContent="Height"
        MinHeight="480"
        MaxHeight="780"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <!-- Кнопки завжди внизу (Dock); поля скроляться окремо — низ не обрізається. -->
    <DockPanel Margin="20,20,20,20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Скасувати" Style="{StaticResource GhostButton}"
                    MinWidth="140" Margin="0,0,8,0" Click="CancelClick"/>
            <Button Content="Зберегти" MinWidth="140" Click="SaveClick"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <TextBox x:Name="TitleBlock" Style="{StaticResource CopyText}"
                         Text="Картка номенклатури" FontSize="22" FontWeight="SemiBold"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Назва" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" MinHeight="40" FontSize="16" Margin="0,0,0,12"/>

                <TextBlock Text="Вид" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <ComboBox x:Name="VydBox" MinHeight="40" FontSize="16" Margin="0,0,0,12"
                          SelectionChanged="VydChanged"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Альтернативні одиниці виміру" FontSize="13"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DisplayUnitBox" MinHeight="40" FontSize="16"
                                  SelectionChanged="DisplayUnitChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Коефіцієнт" FontSize="13"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="FactorBox" MinHeight="40" FontSize="16"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Одиниця виміру" FontSize="13"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="UnitBox" MinHeight="40" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Тип майна" FontSize="13"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="KindBox" MinHeight="40" FontSize="16"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Служба забезпечення" FontSize="13"
                           Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <ComboBox x:Name="SupplyBox" MinHeight="40" FontSize="16" Margin="0,0,0,12"/>

                <TextBlock Text="Примітка" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="NoteBox" MinHeight="72" FontSize="15" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalContentAlignment="Top"
                         Padding="8,8" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
