<Window x:Class="Obozny.StockSummaryStickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Зведені залишки майна"
        Width="360" Height="300"
        MinWidth="280" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        Activated="OnActivated"
        Deactivated="OnDeactivated"
        LocationChanged="OnLocationChanged"
        SizeChanged="OnSizeChanged">
    <Border x:Name="Root" CornerRadius="6" BorderBrush="#33000000" BorderThickness="1" ClipToBounds="True">
        <DockPanel>
            <Border x:Name="ChromeBar" DockPanel.Dock="Top" Height="40" Background="#51947A"
                    MouseLeftButtonDown="AccentDrag">
                <Grid>
                    <TextBlock Text="Зведені залишки"
                               FontSize="13" Foreground="#2C241F"
                               VerticalAlignment="Center" Margin="10,0,96,0"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <Button x:Name="SettingsBtn" Width="40" Height="36" MinWidth="40" MinHeight="36"
                                Margin="0,0,4,0" Padding="0"
                                Background="#22000000" Foreground="#2C241F"
                                Click="SettingsClick" ToolTip="Які види показувати">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CollapseBtn" Content="−" Width="40" Height="36" MinWidth="40" MinHeight="36"
                                Padding="0" FontSize="16" FontWeight="Bold"
                                Background="#22000000" Foreground="#2C241F"
                                Click="CollapseClick" ToolTip="Згорнути"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Margin="12,10,12,12" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">
                <StackPanel>
                    <TextBlock Text="Залишки по Видах:"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#2C241F" TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    <StackPanel x:Name="RowsPanel"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
