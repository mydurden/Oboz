<Window x:Class="Obozny.NewCustomVydWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий вид майна"
        Width="480" MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Скасувати" Style="{StaticResource GhostButton}"
                    IsCancel="True"
                    MinWidth="140" MinHeight="44" Margin="0,0,8,0" Click="CancelClick"/>
            <Button Content="Зберегти" IsDefault="True"
                    MinWidth="140" MinHeight="44" Click="SaveClick"/>
        </StackPanel>

        <StackPanel>
            <TextBox Style="{StaticResource CopyText}"
                     Text="Новий вид майна" FontSize="22" FontWeight="SemiBold"
                     Margin="0,0,0,12"/>
            <TextBlock Text="Назва виду" FontSize="13"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" MinHeight="44" FontSize="16"/>
        </StackPanel>
    </DockPanel>
</Window>
