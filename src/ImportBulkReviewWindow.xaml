<Window x:Class="Obozny.ImportBulkReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перевірка руху майна" Height="720" Width="1180"
        MinHeight="480" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Перевірка перед збереженням" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Muted}"
                       Text="Уся таблиця з файлу в одному вікні. Документи розділені за номером/датою: номер акта, назва ОП і реєстр. номер — окремими стовпцями (можна виправити)."/>
            <TextBlock x:Name="SummaryText" FontSize="13" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="UnknownWarnText" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="#B71C1C" Visibility="Collapsed"
                       Text="Є рядки з невизначеним типом руху (жовта підсвітка). Оберіть тип у стовпці «Тип руху» або змініть намір нижче — не підтверджуйте навмання."/>
            <TextBlock Text="Що ви проводите цим файлом?" Margin="0,12,0,4"
                       Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox x:Name="IntentBox" MinHeight="40" FontSize="15" HorizontalAlignment="Left" MinWidth="360"
                      SelectionChanged="IntentChanged"/>
            <TextBlock Text="Служба забезпечення (авто з «Передає»; можна виправити в стовпці)"
                       Margin="0,12,0,4" Foreground="{DynamicResource TextPrimary}"/>
            <ComboBox x:Name="SupplyAllBox" MinHeight="40" FontSize="15" HorizontalAlignment="Left" MinWidth="280"
                      ToolTip="Застосувати обрану службу до всіх рядків таблиці."
                      SelectionChanged="SupplyAllChanged"/>
        </StackPanel>

        <DataGrid x:Name="LinesGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow"
                  LoadingRow="OnLoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="100" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTemplateColumn Header="Тип руху" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding KindChoices}"
                                      SelectedItem="{Binding KindText, UpdateSourceTrigger=PropertyChanged}"
                                      MinHeight="28" FontSize="13"
                                      SelectionChanged="KindComboChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="№ документа / акта"
                                    Binding="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130" ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn Header="Назва ОП"
                                    Binding="{Binding StrongpointName, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn Header="Реєстр. № ОП"
                                    Binding="{Binding StrongpointReg, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130" ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn Header="Найменування"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="3*" ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn Header="Кількість"
                                    Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="100" ElementStyle="{StaticResource CellRight}"/>
                <DataGridTextColumn Header="О.В."
                                    Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                    Width="70" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Категорія"
                                    Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Ціна"
                                    Binding="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="100" ElementStyle="{StaticResource CellRight}"/>
                <DataGridTemplateColumn Header="Служба забезпечення" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding SupplyChoices}"
                                      SelectedItem="{Binding SupplyService, UpdateSourceTrigger=PropertyChanged}"
                                      MinHeight="36" FontSize="13"
                                      IsSynchronizedWithCurrentItem="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Видалити рядок" Style="{StaticResource GhostButton}" Width="160"
                    Margin="0,0,8,0" Click="DeleteRowClick"/>
            <Button Content="Скасувати" Style="{StaticResource GhostButton}" Width="140"
                    Margin="0,0,8,0" Click="CancelClick"/>
            <Button Content="Підтвердити все" Width="180" Click="ConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
