<Window x:Class="Obozny.BulkSupplyServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Служба забезпечення"
        Width="980" MinWidth="760"
        Height="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Window.Resources>
        <Style x:Key="CellFlatCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Закрити" Style="{StaticResource GhostButton}"
                    MinWidth="140" MinHeight="44" Margin="0,0,8,0" Click="CloseClick"/>
            <Button Content="Зберегти" MinWidth="140" MinHeight="44" Click="SaveClick"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox Style="{StaticResource CopyText}"
                     Text="Служба забезпечення"
                     FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel LastChildFill="False" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="SupplyForAllBox" MinWidth="220" MinHeight="40" FontSize="14"
                              Margin="0,0,8,0"/>
                    <Button Content="Призначити обраним" Style="{StaticResource GhostButton}"
                            MinWidth="180" MinHeight="40" Click="ApplyToSelectedClick"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Border BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Background="{DynamicResource CardBg}" Padding="4" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="FilterGrid" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition x:Name="FilterGutterCol" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilterName" MinHeight="40" FontSize="14" TextChanged="FilterChanged"/>
                    <TextBox x:Name="FilterVyd" Grid.Column="1" MinHeight="40" FontSize="14" TextChanged="FilterChanged"/>
                    <TextBox x:Name="FilterUnit" Grid.Column="2" MinHeight="40" FontSize="14" TextChanged="FilterChanged"/>
                    <TextBox x:Name="FilterSupply" Grid.Column="3" MinHeight="40" FontSize="14" TextChanged="FilterChanged"/>
                </Grid>

                <DataGrid x:Name="RowsGrid" Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          SelectionUnit="FullRow"
                          SelectionMode="Extended"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Item"
                          ScrollViewer.CanContentScroll="True"
                          MinRowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Name}"
                                            SortMemberPath="Name" Width="3*" IsReadOnly="True"
                                            ElementStyle="{StaticResource CellLeft}"/>
                        <DataGridTextColumn Header="Вид" Binding="{Binding VydText}"
                                            SortMemberPath="VydText" Width="2*" IsReadOnly="True"
                                            ElementStyle="{StaticResource CellLeft}"/>
                        <DataGridTextColumn Header="О.В." Binding="{Binding Unit}"
                                            SortMemberPath="Unit" Width="90" IsReadOnly="True"
                                            ElementStyle="{StaticResource CellCenter}"/>
                        <DataGridTemplateColumn Header="Служба забезпечення" Width="180"
                                                SortMemberPath="SelectedSupply" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource CellFlatCombo}"
                                              ItemsSource="{Binding SupplyChoices}"
                                              SelectedItem="{Binding SelectedSupply, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              IsSynchronizedWithCurrentItem="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
