<Window x:Class="Obozny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="uk-UA"
        Title="Обозний"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBg}"
        Activated="OnActivated"
        SizeChanged="OnWindowSizeChanged"
        StateChanged="OnStateChanged"
        Closing="OnClosing">
    <DockPanel>
        <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}" Padding="16,10" MouseLeftButtonUp="HeaderClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                </Grid.ColumnDefinitions>
                <!-- Зліва лише підрозділ; по центру вертикалі відносно ряду кнопок 52px. -->
                <Grid Grid.Column="0" MinHeight="52" VerticalAlignment="Stretch" Margin="0,0,8,0">
                    <TextBlock x:Name="TitleBlock"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Foreground="{DynamicResource HeaderFg}"
                               FontSize="22" FontWeight="SemiBold"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0" MaxWidth="680">
                    <TextBlock x:Name="TableTitleBlock" Foreground="{DynamicResource HeaderFg}" FontSize="15"
                               FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TableSubtitleBlock" Foreground="{DynamicResource HeaderMuted}" FontSize="12"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" MinHeight="52">
                    <Button x:Name="AddStickerBtn" Style="{StaticResource IconButton}"
                            Width="52" Height="52" Margin="0,0,8,0" Visibility="Collapsed"
                            Click="AddSticker">
                        <TextBlock Text="+" FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="StickersBtn" Style="{StaticResource IconButton}"
                            Width="52" Height="52" Margin="0,0,8,0"
                            Click="ToggleStickers">
                        <Grid Width="28" Height="28">
                            <Border Background="#D4A017" CornerRadius="3" Margin="4,2,0,6"/>
                            <Border Background="#F0E6A0" CornerRadius="3" Margin="0,6,4,0" BorderBrush="#C4A000" BorderThickness="1"/>
                        </Grid>
                    </Button>
                    <!-- Візок = лого Обозного замість смайлика профілю; без рамки/фону. -->
                    <Button x:Name="ProfileBtn" Style="{StaticResource HeaderProfileButton}"
                            Width="52" Height="52" VerticalAlignment="Center"
                            Click="OpenProfile">
                        <Image x:Name="HeaderLogo" Width="48" Height="48"
                               Stretch="Uniform" SnapsToDevicePixels="True"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="OpsPanel" DockPanel.Dock="Top" Background="{DynamicResource AccentDark}" Padding="12"
                Visibility="Collapsed" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Column="0" Grid.Row="0" Content="Додати майно на склад" Margin="6" Click="AddProperty"/>
                <Button Grid.Column="0" Grid.Row="1" Content="Підготувати документи на списання майна" Margin="6" Click="PrepareWriteOff"/>
                <Button Grid.Column="0" Grid.Row="2" Content="Переміщення (повернення на склад служби)" Margin="6" Click="PrepareWarehouseMove"/>
                <Button Grid.Column="0" Grid.Row="3" Content="Номенклатура" Margin="6" Click="OpenNomenclature"/>
                <Button Grid.Column="1" Grid.Row="0" x:Name="ReservedBtn" Content="Відобразити зарезервоване майно" Margin="6" Click="ToggleReserved"/>
                <Button Grid.Column="1" Grid.Row="1" x:Name="MovementBtn" Content="Рух майна" Margin="6" Click="ToggleMovements"/>
                <Button Grid.Column="1" Grid.Row="2" x:Name="StrongpointsBtn" Content="Облік опорних пунктів" Margin="6" Click="ToggleStrongpoints"/>
                <Button Grid.Column="1" Grid.Row="3" x:Name="FixedAssetsBtn" Content="Основні засоби" Margin="6"
                        Click="ToggleFixedAssets"/>
                <Button Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2"
                        Content="Книга обліку військового майна (додаток 14)" Margin="6"
                        Click="OpenAccountingBook"/>
            </Grid>
        </Border>

        <!-- Панель чернетки під рядком заголовку (назва акта — у HeaderBar) -->
        <Border x:Name="DraftPanel" DockPanel.Dock="Top" Background="{DynamicResource DraftBg}" Padding="10,4" Visibility="Collapsed"
                AllowDrop="True" Drop="DraftDrop" DragOver="DraftDragOver" DragLeave="DraftDragLeave">
            <StackPanel>
                <!-- Один ряд: усі поля шапки (вкл. ЯС/ЗЯС) + «Примітка» (лише з текстом) + «Виконати дії» -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="DraftHeaderFields" Grid.Column="0" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <!-- ЯС: зліва ВР, потім ЯС; інакше ColVrAct=0, першим лишається номер -->
                            <ColumnDefinition x:Name="ColVrAct" Width="0" MinWidth="0"/>
                            <ColumnDefinition x:Name="ColDraftNum" Width="0.85*" MinWidth="72"/>
                            <ColumnDefinition x:Name="ColDraftDate" Width="1.1*" MinWidth="120"/>
                            <ColumnDefinition x:Name="ColSpName" Width="0" MinWidth="0"/>
                            <ColumnDefinition x:Name="ColCommission" Width="0" MinWidth="0"/>
                            <ColumnDefinition x:Name="ColSpReg" Width="0" MinWidth="0"/>
                            <ColumnDefinition x:Name="ColFormSeries" Width="0" MinWidth="0"/>
                            <ColumnDefinition x:Name="ColFormNumber" Width="0" MinWidth="0"/>
                            <ColumnDefinition x:Name="ColBarrier" Width="0" MinWidth="0"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="VrActNumberPanel" Grid.Column="0" Margin="0,0,6,0"
                                    VerticalAlignment="Bottom" Visibility="Collapsed">
                            <TextBlock Text="Акт виконаних робіт" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,1"/>
                            <TextBox x:Name="VrActNumberBox" MinHeight="32" Height="32" FontSize="13" Padding="6,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Bottom">
                            <TextBlock x:Name="DraftNumberLabel" Text="№" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,1"/>
                            <TextBox x:Name="DraftNumberBox" MinHeight="32" Height="32" FontSize="13" Padding="6,2"
                                     GotKeyboardFocus="DraftNumberGotFocus"
                                     LostKeyboardFocus="DraftNumberLostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Bottom">
                            <TextBlock Text="Дата документа" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,1"/>
                            <DatePicker x:Name="DraftDate" Style="{StaticResource CompactDatePicker}"
                                        SelectedDateChanged="DraftDateChanged"/>
                        </StackPanel>

                        <StackPanel x:Name="StrongpointNamePanel" Grid.Column="3" Margin="0,0,6,0"
                                    VerticalAlignment="Bottom" Visibility="Collapsed">
                            <TextBlock Text="Назва опорного пункту" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,1"/>
                            <TextBox x:Name="StrongpointNameBox" MinHeight="32" Height="32" FontSize="13" Padding="6,2"/>
                        </StackPanel>
                        <StackPanel x:Name="CommissioningDatePanel" Grid.Column="4" Margin="0,0,6,0"
                                    VerticalAlignment="Bottom" Visibility="Collapsed">
                            <TextBlock Text="Дата введення в експлуатацію" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,1"/>
                            <DatePicker x:Name="CommissioningDateBox" Style="{StaticResource CompactDatePicker}"
                                        SelectedDateChanged="CommissioningDateChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="StrongpointRegPanel" Grid.Column="5" Margin="0,0,6,0"
                                    VerticalAlignment="Bottom" Visibility="Collapsed">
                            <TextBlock Text="Реєстр. номер опорного пункту" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,1"/>
                            <TextBox x:Name="StrongpointRegBox" MinHeight="32" Height="32" FontSize="13" Padding="6,2"/>
                        </StackPanel>

                        <StackPanel x:Name="FormSeriesPanel" Grid.Column="6" Margin="0,0,6,0"
                                    VerticalAlignment="Bottom" Visibility="Collapsed">
                            <TextBlock Text="Серія формуляру" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,1"/>
                            <TextBox x:Name="FormSeriesBox" MinHeight="32" Height="32" FontSize="13" Padding="6,2"/>
                        </StackPanel>
                        <StackPanel x:Name="FormNumberPanel" Grid.Column="7" Margin="0,0,6,0"
                                    VerticalAlignment="Bottom" Visibility="Collapsed">
                            <TextBlock Text="Номер формуляру" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,1"/>
                            <TextBox x:Name="FormNumberBox" MinHeight="32" Height="32" FontSize="13" Padding="6,2"/>
                        </StackPanel>
                        <StackPanel x:Name="BarrierNamePanel" Grid.Column="8" Margin="0,0,6,0"
                                    VerticalAlignment="Bottom" Visibility="Collapsed">
                            <TextBlock Text="Назва інженерного загородження" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,1"/>
                            <TextBox x:Name="BarrierNameBox" MinHeight="32" Height="32" FontSize="13" Padding="6,2"/>
                        </StackPanel>
                    </Grid>

                    <!-- На панелі лише коли в примітці вже є текст; додати — через меню дій -->
                    <Button Grid.Column="1" x:Name="DraftNoteBtn" Content="Примітка"
                            MinWidth="110" MinHeight="32" Height="32"
                            FontSize="13" Padding="10,2" Style="{StaticResource GhostButton}"
                            FocusVisualStyle="{x:Null}"
                            Click="EditDraftNote" Margin="4,0,0,0" VerticalAlignment="Bottom"
                            Visibility="Collapsed"/>

                    <!-- Дії чернетки — одне меню; «+ Споруда» / чіпи лишаються нижче окремо -->
                    <Button Grid.Column="2" x:Name="DraftActionsBtn" Content="Виконати дії ▾"
                            MinWidth="148" MinHeight="32" Height="32" FontSize="13" Padding="12,4"
                            Click="OpenDraftActions" Margin="8,0,0,0" VerticalAlignment="Bottom"
                            HorizontalAlignment="Right">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="DraftActionsMenu" Tag="no-ui-copy">
                                <MenuItem x:Name="DraftOzItem" Header="Основні засоби" IsCheckable="True"
                                          Click="ToggleDraftOz"/>
                                <MenuItem Header="Примітка" Click="EditDraftNote"/>
                                <MenuItem Header="Зберегти чернетку" Click="SaveDraft"/>
                                <MenuItem x:Name="OpDocsItem" Header="Документи опорного пункту"
                                          Click="OpenOpDocsFromDraft"
                                          Visibility="Collapsed"/>
                                <MenuItem x:Name="VrActFromDraftItem" Header="Акт виконаних робіт"
                                          Click="OpenVrActFromDraft"
                                          Visibility="Collapsed"/>
                                <MenuItem Header="В Excel" Click="ExportDraftExcel"/>
                                <MenuItem Header="Провести" Style="{StaticResource DangerMenuItem}" Click="PostDraft"/>
                                <MenuItem Header="Видалити" Style="{StaticResource DangerMenuItem}" Click="DeleteDraft"/>
                                <MenuItem Header="Закрити" Click="CloseDraft"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <TextBlock x:Name="DraftHint"
                           Text="Можете додати майно подвійним натисканням або простим перетягуванням"
                           Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <!-- Споруди: чіпи-вкладки над окремим полем майна (без «браузерного» шва) -->
                <Grid x:Name="DraftContentFrame" VerticalAlignment="Top"
                      AllowDrop="True" Drop="DraftDrop" DragOver="DraftDragOver" DragLeave="DraftDragLeave"
                      SizeChanged="DraftContentFrameSizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="StructuresHost" Grid.Row="0"
                          Visibility="Collapsed" Height="48" Margin="0,0,0,8"
                          SizeChanged="StructuresHostSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StructPrevBtn" Grid.Column="0" Content="‹"
                                Width="40" MinWidth="40" MinHeight="40" Height="40" FontSize="18"
                                Padding="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                Style="{StaticResource GhostButton}" Click="StructurePrev"/>
                        <Grid Grid.Column="1" Height="48" VerticalAlignment="Center" ClipToBounds="True">
                            <Canvas x:Name="StructuresStrip" Height="48" ClipToBounds="True"/>
                            <!-- натяки, що зліва/справа ще є вкладки -->
                            <Border x:Name="StructFadeLeft" Width="28" HorizontalAlignment="Left"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FFF8F4" Offset="0"/>
                                        <GradientStop Color="#00FFF8F4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="StructFadeRight" Width="28" HorizontalAlignment="Right"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                                        <GradientStop Color="#FFF8F4" Offset="0"/>
                                        <GradientStop Color="#00FFF8F4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <Button x:Name="StructNextBtn" Grid.Column="2" Content="›"
                                Width="40" MinWidth="40" MinHeight="40" Height="40" FontSize="18"
                                Padding="0" Margin="6,0,6,0" VerticalAlignment="Center"
                                Style="{StaticResource GhostButton}" Click="StructureNext"/>
                        <Button x:Name="AddStructureBtn" Grid.Column="3" Content="＋  Споруда"
                                MinHeight="40" Height="40" FontSize="13" Padding="12,2"
                                VerticalAlignment="Center"
                                Click="AddStructure" Style="{StaticResource GhostButton}"/>
                    </Grid>

                    <Border x:Name="DraftLinesHost" Grid.Row="1"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="6,4"
                            SnapsToDevicePixels="True" VerticalAlignment="Top">
                        <DataGrid x:Name="DraftLines" FontSize="15" BorderThickness="0" Background="Transparent"
                                  HeadersVisibility="None" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource GridLine}" RowHeight="44"
                                  MinHeight="88" Height="88"
                                  VerticalScrollBarVisibility="Auto"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  SelectionMode="Single" LoadingRow="OnDraftLoadingRow"
                                  Stylus.IsPressAndHoldEnabled="False"
                                  Stylus.IsFlicksEnabled="False"
                                  MouseDoubleClick="DraftLinesDoubleClick"
                                  PreviewMouseLeftButtonDown="DraftLinesMouseDown"
                                  PreviewMouseMove="DraftLinesMouseMove"
                                  PreviewMouseLeftButtonUp="DraftLinesMouseUp"
                                  PreviewTouchDown="DraftLinesTouchDown"
                                  PreviewTouchMove="DraftLinesTouchMove"
                                  PreviewTouchUp="DraftLinesTouchUp"
                                  LostTouchCapture="DraftLinesLostTouch">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Name}" Width="*"
                                                    ElementStyle="{StaticResource DraftNameCell}"/>
                                <DataGridTextColumn x:Name="DraftUnitCol" Binding="{Binding Unit}"
                                                    Width="56" MinWidth="40"
                                                    ElementStyle="{StaticResource DraftUnitCell}"/>
                                <!-- фіксована ширина: − / кількість / + вирівняні в усіх рядках -->
                                <DataGridTemplateColumn Width="176">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <Button Content="−" Width="40" MinHeight="40" Tag="{Binding}"
                                                        Stylus.IsPressAndHoldEnabled="False"
                                                        PreviewMouseLeftButtonDown="QtyMinusPress"
                                                        PreviewMouseLeftButtonUp="QtyMinusRelease"
                                                        LostMouseCapture="QtyMinusLostMouse"
                                                        PreviewTouchDown="QtyMinusTouchPress"
                                                        PreviewTouchUp="QtyMinusTouchRelease"
                                                        LostTouchCapture="QtyMinusLostTouch"/>
                                                <Button Content="{Binding Quantity, Converter={StaticResource QtyFormat}}"
                                                        Width="88" MinWidth="88" MinHeight="40"
                                                        Padding="8,2" Click="QtyEdit" Tag="{Binding}"
                                                        Style="{StaticResource DraftQtyButton}"/>
                                                <Button Content="+" Width="40" MinHeight="40" Click="QtyPlus" Tag="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                <Button x:Name="ExportTableBtn" Content="В Excel" MinWidth="96" MinHeight="32" Height="32"
                        FontSize="14" Padding="10,2" Margin="0,0,6,0"
                        Style="{StaticResource GhostButton}" Click="ExportTableExcel"
                        Visibility="Collapsed"/>
                <Button x:Name="ColsBtn" Style="{StaticResource CompactIconButton}"
                        VerticalAlignment="Center" Click="OpenColumns">
                    <TextBlock Text="▦" FontSize="13"/>
                </Button>
            </StackPanel>
            <Grid x:Name="FilterGrid" Grid.Row="1" Margin="0,0,0,6"/>
            <Border x:Name="TotalsHost" Grid.Row="2" Margin="0,0,0,6" Visibility="Collapsed"
                    Background="{DynamicResource HeaderCellBg}"
                    BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,1">
                <Grid x:Name="TotalsGrid"/>
            </Border>
            <Popup x:Name="ColsPopup" PlacementTarget="{Binding ElementName=ColsBtn}" StaysOpen="False"
                   AllowsTransparency="True" Placement="Bottom">
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="12" CornerRadius="8"
                        MinWidth="280">
                    <StackPanel x:Name="ColsList"/>
                </Border>
            </Popup>
            <DataGrid x:Name="PropertyGrid" Grid.Row="3"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Auto"
                      Stylus.IsPressAndHoldEnabled="False"
                      Stylus.IsFlicksEnabled="False"
                      AllowDrop="True"
                      DragOver="PropertyGridDragOver"
                      Drop="PropertyGridDrop"
                      MouseLeftButtonUp="RowClick"
                      MouseDoubleClick="GridDoubleClick"
                      PreviewMouseLeftButtonDown="GridMouseDown"
                      PreviewMouseMove="GridMouseMove"
                      PreviewMouseLeftButtonUp="GridMouseUp"
                      PreviewTouchDown="GridTouchDown"
                      PreviewTouchMove="GridTouchMove"
                      PreviewTouchUp="GridTouchUp"
                      LostTouchCapture="GridLostTouchCapture"
                      LoadingRow="OnLoadingRow"
                      ColumnReordered="ColumnsChanged"/>
        </Grid>
    </DockPanel>
</Window>
