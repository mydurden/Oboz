<Window x:Class="Obozny.ImportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перевірка документа" Height="600" Width="900"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBox x:Name="TitleText" Style="{StaticResource CopyText}" FontSize="22" FontWeight="SemiBold"/>
            <StackPanel x:Name="IntentPanel" Margin="0,12,0,0">
                <ComboBox x:Name="IntentBox" MinHeight="40" FontSize="15"
                          SelectionChanged="IntentChanged"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Номер документа" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBox x:Name="NumberBox" MinHeight="40"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Служба забезпечення" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextPrimary}"/>
                <ComboBox x:Name="SupplyBox" MinHeight="40" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Дата документа" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextPrimary}"/>
                <DatePicker x:Name="DateBox" SelectedDateFormat="Short"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="LinesGrid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Найменування"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="3*" ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn x:Name="CategoryCol" Header="Категорія"
                                    Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Кількість"
                                    Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120" ElementStyle="{StaticResource CellRight}"/>
                <DataGridTextColumn Header="О.В."
                                    Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80" ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn x:Name="PriceCol" Header="Ціна"
                                    Binding="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="100" ElementStyle="{StaticResource CellRight}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Видалити рядок" Style="{StaticResource GhostButton}" Width="160"
                    Margin="0,0,8,0" Click="DeleteRowClick"/>
            <Button Content="Скасувати" Style="{StaticResource GhostButton}" Width="140"
                    Margin="0,0,8,0" Click="CancelClick"/>
            <Button Content="Підтвердити" Width="160" Click="ConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
