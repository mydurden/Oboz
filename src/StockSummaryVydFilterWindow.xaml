<Window x:Class="Obozny.StockSummaryVydFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Які види показувати"
        Width="780" MinWidth="640"
        Height="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Скасувати" Style="{StaticResource GhostButton}"
                    IsCancel="True"
                    MinWidth="140" MinHeight="44" Margin="0,0,8,0" Click="CancelClick"/>
            <!-- Порожній вибір (0 галочок) дозволений — EnabledVyds=[]. -->
            <Button Content="Зберегти" IsDefault="True" IsEnabled="True"
                    MinWidth="140" MinHeight="44" Click="SaveClick"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBox Style="{StaticResource CopyText}"
                     Text="Які види показувати" FontSize="22" FontWeight="SemiBold"
                     Margin="0,0,0,8"/>
            <TextBlock FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                       Text="Галочка — вид у нотатці. О.В. відображення — підсумок через коефіцієнти карток."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Обрати всі" Style="{StaticResource GhostButton}"
                        MinWidth="130" MinHeight="40" Margin="0,0,8,0"
                        Click="SelectAllClick"/>
                <Button Content="Зняти всі" Style="{StaticResource GhostButton}"
                        MinWidth="130" MinHeight="40"
                        Click="ClearAllClick"/>
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Background="{DynamicResource CardBg}" Padding="4" CornerRadius="8">
            <DataGrid x:Name="RowsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.CanContentScroll="True"
                      MinRowHeight="44"
                      PreviewMouseLeftButtonDown="RowsGridRowClick"
                      PreviewTouchDown="RowsGridTouchDown">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="48" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Вид" Binding="{Binding Name}" Width="2*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellLeft}"/>
                    <!-- IsReadOnly: без edit-mode DataGrid; ComboBox лишається інтерактивним у CellTemplate. -->
                    <DataGridTemplateColumn Header="О.В. відображення" Width="1.4*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DisplayChoices}"
                                          SelectedItem="{Binding SelectedDisplayUnit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          MinHeight="40" FontSize="14"
                                          IsSynchronizedWithCurrentItem="False"
                                          IsEnabled="{Binding IsSelected}"
                                          SelectionChanged="DisplayUnitComboChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
