<Window x:Class="Obozny.SummaryStatementMonthPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Узагальнююча відомість (Додаток 1)"
        Width="480" MinWidth="420"
        SizeToContent="Height" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}"
        FontFamily="{DynamicResource AppFont}">
    <DockPanel Margin="12" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Скасувати" Style="{StaticResource GhostButton}"
                    IsCancel="True"
                    MinWidth="120" MinHeight="44" Height="44" Margin="0,0,8,0"
                    Click="CancelClick"/>
            <Button Content="Показати" IsDefault="True"
                    Style="{StaticResource GhostButton}"
                    MinWidth="140" MinHeight="44" Height="44"
                    Click="OkClick"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Узагальнююча відомість (Додаток 1)"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="Суцільний діапазон місяців → таблиця на екрані. Excel — лише «Зберегти в Excel»."
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>

            <!-- Рік зліва + короткий номер справа — один ряд -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="100"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Рік" FontSize="13"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="YearBox" Grid.Column="1"
                          MinWidth="96" MinHeight="40" Height="40"
                          FontSize="14" VerticalContentAlignment="Center"
                          SelectionChanged="YearChanged"/>
                <DockPanel Grid.Column="3" LastChildFill="True">
                    <TextBlock Text="Номер відомості" FontSize="12"
                               Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               DockPanel.Dock="Left"/>
                    <TextBox x:Name="NumberBox" MinHeight="40" Height="40"
                             FontSize="14" VerticalContentAlignment="Center"
                             ToolTip="Порожньо — місце під рукопис"/>
                </DockPanel>
            </Grid>

            <!-- Служба забезпечення -->
            <TextBlock Text="Служба забезпечення" FontSize="12"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <ComboBox x:Name="SupplyBox"
                      MinHeight="40" Height="40" Margin="0,0,0,10"
                      FontSize="14" VerticalContentAlignment="Center"/>

            <TextBlock Text="Місяці" FontSize="12"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="6">
                <UniformGrid x:Name="MonthsPanel" Columns="4"/>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
