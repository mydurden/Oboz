<Window x:Class="Obozny.StrongpointCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Картка опорного пункту" Height="640" Width="920"
        MinHeight="440" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8">
            <TextBox x:Name="TitleText" Style="{StaticResource CopyText}" FontSize="22" FontWeight="SemiBold"/>
            <TextBox x:Name="InfoText" Style="{StaticResource CopyText}" Margin="0,8,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Майно опорного пункту" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

        <DataGrid x:Name="PropertyGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Споруда" Binding="{Binding StructureName}" Width="1.2*"
                                    ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn Header="Найменування" Binding="{Binding Name}" Width="2.5*"
                                    ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn Header="О.В." Binding="{Binding Unit}" Width="70"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Кількість" Binding="{Binding QuantityText}" Width="100"
                                    ElementStyle="{StaticResource CellRight}"/>
                <DataGridTextColumn Header="Ціна" Binding="{Binding PriceText}" Width="100"
                                    ElementStyle="{StaticResource CellRight}"/>
                <DataGridTextColumn Header="Вартість" Binding="{Binding ValueText}" Width="110"
                                    ElementStyle="{StaticResource CellRight}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="Документи опорного пункту" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="OpenYasBtn" Content="Акт ЯС" Style="{StaticResource GhostButton}"
                    MinWidth="140" MinHeight="44" Margin="0,0,8,0"
                    Click="OpenPrimaryYasClick"/>
            <Button Content="Акт ВР" Style="{StaticResource GhostButton}"
                    MinWidth="140" MinHeight="44"
                    Click="OpenVrClick"/>
        </StackPanel>

        <DataGrid x:Name="DocsGrid" Grid.Row="5" IsReadOnly="True" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  MouseDoubleClick="OpenSelectedDocument">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Документ" Binding="{Binding Kind}" Width="120"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="160"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="120"
                                    ElementStyle="{StaticResource CellCenter}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="6" Content="Закрити" Style="{StaticResource GhostButton}"
                HorizontalAlignment="Right" MinWidth="140" MinHeight="44" Margin="0,16,0,0"
                Click="CloseClick"/>
    </Grid>
</Window>
