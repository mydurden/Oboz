<Window x:Class="Obozny.TypePickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підготувати документи на списання майна"
        Height="640" Width="640"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Text="Оберіть вид робіт / підставу списання"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel x:Name="ChoicesPanel"/>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Скасувати" Style="{StaticResource GhostButton}"
                HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="Cancel"/>
    </Grid>
</Window>
