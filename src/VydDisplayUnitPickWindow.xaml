<Window x:Class="Obozny.VydDisplayUnitPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О.В. відображення"
        Width="520" MinWidth="420"
        Height="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Скасувати" Style="{StaticResource GhostButton}"
                    IsCancel="True"
                    MinWidth="140" MinHeight="44" Margin="0,0,8,0" Click="CancelClick"/>
            <Button Content="Додати" IsDefault="True"
                    MinWidth="140" MinHeight="44" Click="SaveClick"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBox Style="{StaticResource CopyText}"
                     Text="О.В. відображення" FontSize="22" FontWeight="SemiBold"
                     Margin="0,0,0,8"/>
            <TextBlock x:Name="HintText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                       Text="Вкажіть свою О.В. або оберіть зі списку тих, що вже є на картках номенклатури (відмінні від уже заданих для цього виду)."/>
            <TextBlock Text="Своя О.В." FontSize="13"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="OwnBox" MinHeight="44" FontSize="16" Margin="0,0,0,12"
                     TextChanged="OwnBoxChanged"/>
            <TextBlock Text="З бази (картки номенклатури)" FontSize="13"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Background="{DynamicResource CardBg}" Padding="4" CornerRadius="8">
            <ListBox x:Name="BaseList"
                     FontSize="15"
                     MinHeight="40"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="BaseListDoubleClick"/>
        </Border>
    </DockPanel>
</Window>
