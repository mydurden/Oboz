<Window x:Class="Obozny.VrActViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Акт ВР" Height="600" Width="860"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBox x:Name="TitleText" Style="{StaticResource CopyText}" FontSize="22" FontWeight="SemiBold"/>
            <TextBox x:Name="InfoText" Style="{StaticResource CopyText}" Margin="0,8,0,0"
                     Foreground="{DynamicResource Muted}"/>
        </StackPanel>

        <DataGrid x:Name="LinesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Найменування" Binding="{Binding Name}" Width="3*"
                                    ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn Header="Од. вим." Binding="{Binding Unit}" Width="100"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Кількість" Binding="{Binding QuantityText}" Width="120"
                                    ElementStyle="{StaticResource CellRight}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Друк" Style="{StaticResource GhostButton}"
                        MinWidth="120" MinHeight="44" Margin="0,0,8,0" Click="PrintClick"/>
                <Button Content="Зберегти в Excel" Style="{StaticResource GhostButton}"
                        MinWidth="180" MinHeight="44" Click="ExcelClick"/>
            </StackPanel>
            <Button Content="Закрити" Style="{StaticResource GhostButton}"
                    DockPanel.Dock="Right" MinWidth="140" MinHeight="44" Click="CloseClick"/>
        </DockPanel>
    </Grid>
</Window>
