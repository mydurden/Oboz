<Window x:Class="Obozny.StickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Стікер"
        Width="300" Height="300"
        MinWidth="180" MinHeight="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        Activated="OnActivated"
        Deactivated="OnDeactivated"
        LocationChanged="OnLocationChanged"
        SizeChanged="OnSizeChanged">
    <Border x:Name="Root" CornerRadius="6" BorderBrush="#33000000" BorderThickness="1" ClipToBounds="True">
        <DockPanel>
            <Grid x:Name="ChromeBar" DockPanel.Dock="Top" Height="32"
                  Background="#D4A017" MouseLeftButtonDown="AccentDrag">
                <Button x:Name="CloseBtn" Content="&#xE74D;" Width="28" Height="24" MinWidth="28" MinHeight="24"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                        Padding="0" FontSize="14" FontFamily="Segoe MDL2 Assets"
                        Background="#22000000" Foreground="#2C241F" Click="DeleteSticker" ToolTip="Видалити стікер"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="MenuBtn" Content="⋯" Width="28" Height="24" MinHeight="24" MinWidth="28" Margin="0,0,4,0"
                            FontSize="16" FontWeight="Bold" Padding="0" FontFamily="Segoe UI"
                            Background="#22000000" Foreground="#2C241F" Click="OpenMenu" ToolTip="Налаштування"/>
                    <Button x:Name="CollapseBtn" Content="−" Width="28" Height="24" MinWidth="28" MinHeight="24"
                            Padding="0" FontSize="16" FontWeight="Bold" FontFamily="Segoe UI"
                            Background="#22000000" Foreground="#2C241F" Click="CollapseClick" ToolTip="Згорнути"/>
                </StackPanel>
                <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuBtn}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#F7F7F2" BorderBrush="#C5D0C5" BorderThickness="1" CornerRadius="8" Padding="10" MinWidth="240">
                        <StackPanel>
                            <Button Content="Копіювати стікер" Style="{StaticResource GhostButton}"
                                    Margin="0,0,0,8" Click="CopySticker"/>
                            <TextBlock Text="Колір" FontSize="13" Foreground="#5C6B63" Margin="0,0,0,6"/>
                            <UniformGrid x:Name="ColorGrid" Columns="5"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Border x:Name="Toolbar" DockPanel.Dock="Bottom" Padding="6,4" Visibility="Collapsed"
                    Background="#18000000">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FontMinusBtn" Content="−" Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0" FontSize="16"
                                Background="#22000000" Foreground="#2C241F" Click="FontMinus" ToolTip="Зменшити шрифт"/>
                        <TextBlock x:Name="FontSizeLabel" Text="16" Width="28" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#2C241F" FontSize="13" Margin="2,0"/>
                        <Button x:Name="FontPlusBtn" Content="+" Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0" FontSize="16"
                                Background="#22000000" Foreground="#2C241F" Click="FontPlus" ToolTip="Збільшити шрифт"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BoldBtn" Content="B" Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0" FontWeight="Bold" FontSize="14"
                                Background="#22000000" Foreground="#2C241F" Click="FmtBold" ToolTip="Жирний"/>
                        <Button x:Name="ItalicBtn" Content="I" Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0" FontStyle="Italic" FontSize="14"
                                Background="#22000000" Foreground="#2C241F" Margin="3,0,0,0" Click="FmtItalic" ToolTip="Курсив"/>
                        <Button x:Name="UnderlineBtn" Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0" Background="#22000000"
                                Margin="3,0,0,0" Click="FmtUnderline" ToolTip="Підкреслений">
                            <TextBlock x:Name="UnderlineGlyph" Text="U" TextDecorations="Underline" Foreground="#2C241F" FontSize="14"/>
                        </Button>
                        <Button x:Name="StrikeBtn" Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0" Background="#22000000"
                                Margin="3,0,0,0" Click="FmtStrike" ToolTip="Закреслений">
                            <TextBlock x:Name="StrikeGlyph" Text="S" TextDecorations="Strikethrough" Foreground="#2C241F" FontSize="14"/>
                        </Button>
                        <Button x:Name="ListBtn" Content="≡" Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0" FontSize="14"
                                Background="#22000000" Foreground="#2C241F" Margin="3,0,0,0" Click="FmtList" ToolTip="Список"/>
                        <Button x:Name="LinkBtn" Content="&#xE71B;" Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0"
                                FontSize="14" FontFamily="Segoe MDL2 Assets"
                                Background="#22000000" Foreground="#2C241F" Margin="3,0,0,0" Click="EditLink" ToolTip="Посилання"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="10,6,10,6" Background="Transparent" MouseLeftButtonDown="BodyActivate">
                <RichTextBox x:Name="Editor" BorderThickness="0" Background="Transparent"
                             Foreground="#2C241F" CaretBrush="#2C241F"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextChanged="EditorChanged"
                             GotKeyboardFocus="EditorFocus"
                             LostKeyboardFocus="EditorBlur"
                             PreviewMouseLeftButtonDown="EditorMouseDown"
                             PreviewMouseLeftButtonUp="EditorMouseUp">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                        <Style TargetType="Hyperlink">
                            <Setter Property="Foreground" Value="#1B4F8A"/>
                            <Setter Property="TextDecorations" Value="Underline"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
                <TextBlock x:Name="Placeholder"
                           Text="Введіть будь-який вміст, який потрібно запам'ятати"
                           Foreground="#992C241F" FontSize="15" TextWrapping="Wrap"
                           IsHitTestVisible="False" Margin="2,0,0,0"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
