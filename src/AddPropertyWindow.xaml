<Window x:Class="Obozny.AddPropertyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати майно на склад" Height="640" Width="980"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource Muted}"
                   Text="Заповніть таблицю вручну або вставте з Excel/Word (Ctrl+V / контекстне меню). Можна виділити кілька клітинок (Shift/Ctrl). Delete — очистити виділене. Після заповнення останнього рядка з’являється новий."/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Номер документу" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBox x:Name="DocNumberBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Дата документу" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextPrimary}"/>
                <DatePicker x:Name="DocDateBox" SelectedDateFormat="Short"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="LinesGrid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  SelectionUnit="Cell"
                  ClipboardCopyMode="ExcludeHeader"
                  CellEditEnding="LinesCellEditEnding"
                  PreviewKeyDown="LinesPreviewKeyDown">
            <DataGrid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Вставити" InputGestureText="Ctrl+V" Click="ContextPaste"/>
                    <MenuItem Header="Копіювати" InputGestureText="Ctrl+C" Click="ContextCopy"/>
                    <Separator/>
                    <MenuItem Header="Видалити" InputGestureText="Delete" Click="ContextDelete"/>
                    <MenuItem Header="Очистити рядок" Click="ContextClearRow"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Найменування майна"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2.2*" IsReadOnly="False"
                                    ElementStyle="{StaticResource CellLeft}"/>
                <DataGridTextColumn Header="Категорія"
                                    Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" IsReadOnly="False"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Кількість"
                                    Binding="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="0.8*" IsReadOnly="False"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="О.В."
                                    Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                    Width="0.7*" IsReadOnly="False"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Ціна"
                                    Binding="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                    Width="0.8*" IsReadOnly="False"
                                    ElementStyle="{StaticResource CellCenter}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Content="Завантажити з файлу Excel / CSV"
                    Style="{StaticResource GhostButton}" Padding="14,8" Click="ImportFile"
                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Скасувати" Style="{StaticResource GhostButton}" Width="140"
                        Click="Cancel" Margin="0,0,8,0"/>
                <Button Content="Зберегти" Width="160" Click="Save"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
