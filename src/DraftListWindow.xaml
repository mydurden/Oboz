<Window x:Class="Obozny.DraftListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документи" Height="520" Width="760"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Hint" Visibility="Collapsed" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,12"
                   Foreground="{DynamicResource Muted}"/>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  MouseDoubleClick="GridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер документа" Binding="{Binding Number}" Width="180"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="120"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Примітка" Binding="{Binding Note}" Width="*"
                                    ElementStyle="{StaticResource CellLeft}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Створити новий документ" HorizontalAlignment="Left" MinWidth="260"
                    Click="CreateClick"/>
            <Button Content="Закрити" Style="{StaticResource GhostButton}" Width="140"
                    HorizontalAlignment="Right" Click="CloseClick"/>
        </Grid>
    </Grid>
</Window>
