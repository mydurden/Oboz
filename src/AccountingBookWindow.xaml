<Window x:Class="Obozny.AccountingBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Книга обліку військового майна (додаток 14)"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок + «До змісту» -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <Button x:Name="BackBtn" DockPanel.Dock="Left"
                    Content="← До змісту"
                    Style="{StaticResource GhostButton}"
                    MinWidth="160" MinHeight="44" Height="44"
                    FontSize="14" Padding="14,4" Margin="0,0,12,0"
                    Visibility="Collapsed" Click="BackClick"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleBlock" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                           Text="Зміст"/>
                <TextBlock x:Name="SubtitleBlock" Margin="0,4,0,0" FontSize="13"
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           Visibility="Collapsed" Text=""/>
            </StackPanel>
        </DockPanel>

        <!-- Зміст: період Від–До + список видів із рухами в періоді -->
        <Border x:Name="TocHost" Grid.Row="1"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource InputBorder}"
                BorderThickness="1" CornerRadius="12" Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                            Margin="8,4,8,12" VerticalAlignment="Center">
                    <TextBlock Text="Від" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="PeriodFromBox"
                                Style="{StaticResource CompactDatePicker}"
                                Width="148" SelectedDateFormat="Short"
                                VerticalAlignment="Center"
                                SelectedDateChanged="PeriodChanged"/>
                    <TextBlock Text="До" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <DatePicker x:Name="PeriodToBox"
                                Style="{StaticResource CompactDatePicker}"
                                Width="148" SelectedDateFormat="Short"
                                VerticalAlignment="Center"
                                SelectedDateChanged="PeriodChanged"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ItemsControl x:Name="TocList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        MinHeight="48" Height="48"
                                        FontSize="15" Padding="16,4"
                                        Margin="4" HorizontalContentAlignment="Left"
                                        Style="{StaticResource GhostButton}"
                                        Click="TocItemClick"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Розділ Виду: sticky поза V-скролом; H+V на тілі; qty sticky їде по H; ліві 4 — H-freeze. -->
        <Border x:Name="SectionHost" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource InputBorder}"
                BorderThickness="1" CornerRadius="12" Padding="4">
            <Grid>
                <TextBlock x:Name="EmptyHint" Visibility="Collapsed"
                           Text=""
                           FontSize="15" Foreground="{DynamicResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="24"/>
                <Grid x:Name="SectionTableHost" Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- До скролу: лише найменування (трійка — знизу повної шапки в тілі).
                         Після V-скролу mid: назва + трійка + межа 4 лівих. Canvas.Left = pad − H. -->
                    <Border x:Name="StickyClip" Grid.Row="0" ClipToBounds="True">
                        <Canvas x:Name="StickyCanvas"/>
                    </Border>
                    <ScrollViewer x:Name="SectionScroll" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PanningMode="Both">
                        <Grid x:Name="SectionGrid"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="SummaryStatementBtn"
                        Content="Узагальнююча відомість (Додаток 1)"
                        Style="{StaticResource GhostButton}"
                        MinWidth="280" MinHeight="44" Height="44"
                        FontSize="14" Padding="14,4" Margin="0,0,8,0"
                        Click="SummaryStatementClick"/>
                <ToggleButton x:Name="PresenceFilterBtn"
                              Content="Фільтр по наявності"
                              Style="{StaticResource GhostToggle}"
                              MinWidth="200" MinHeight="44" Height="44"
                              Visibility="Collapsed"
                              Checked="PresenceFilterChanged"
                              Unchecked="PresenceFilterChanged"/>
            </StackPanel>
            <Button Content="Закрити" Style="{StaticResource GhostButton}"
                    Width="140" MinHeight="44" Height="44"
                    HorizontalAlignment="Right" IsCancel="True" Click="CloseClick"/>
        </Grid>
    </Grid>
</Window>
