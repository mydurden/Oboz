<Window x:Class="Obozny.DocumentViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документ" Height="600" Width="900"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBox x:Name="TitleText" Style="{StaticResource CopyText}" FontSize="22" FontWeight="SemiBold"/>
            <TextBox x:Name="InfoText" Style="{StaticResource CopyText}" Margin="0,8,0,0"
                     Foreground="{DynamicResource Muted}"/>
        </StackPanel>

        <DataGrid x:Name="LinesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False" LoadingRow="OnLoadingRow"/>

        <TextBox x:Name="TotalText" Grid.Row="2" Style="{StaticResource CopyText}"
                 FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,10,0,0"
                 TextAlignment="Right" Visibility="Collapsed"/>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <!-- Окремі кнопки: Примітка (якщо є), Картка ОП, Відкрити чернетку / Редагувати -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="NoteBtn" Content="Примітка" Style="{StaticResource GhostButton}"
                        MinWidth="140" MinHeight="44" Margin="0,0,8,0"
                        FocusVisualStyle="{x:Null}"
                        Visibility="Collapsed" Click="NoteClick"/>
                <Button x:Name="OpCardBtn" Content="Картка ОП" Style="{StaticResource GhostButton}"
                        MinWidth="140" MinHeight="44" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="OpenOpCardClick"
                        ToolTip="Документи опорного пункту: картка, Акт ЯС, Акт ВР"/>
                <Button x:Name="VrActBtn" Content="Акт ВР" Style="{StaticResource GhostButton}"
                        MinWidth="140" MinHeight="44" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="OpenVrActClick"
                        ToolTip="Перегляд парного Акта виконаних робіт (без вартості та категорії)"/>
                <Button x:Name="EditDraftBtn" Content="Відкрити чернетку" Style="{StaticResource GhostButton}"
                        MinWidth="160" MinHeight="44" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="EditDraftClick"/>
                <Button x:Name="EditPostedBtn" Content="Редагувати" Style="{StaticResource GhostButton}"
                        MinWidth="140" MinHeight="44" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="EditDraftClick"
                        ToolTip="Відкрити акт для редагування в чернетці (дата і № ВР — лише там)"/>
            </StackPanel>

            <Button x:Name="ActionsBtn" Content="Виконати дії ▾" Style="{StaticResource GhostButton}"
                    DockPanel.Dock="Right" MinWidth="160" MinHeight="44"
                    HorizontalAlignment="Right" Click="OpenActions"
                    ToolTip="Друк, Excel, видалити, закрити">
                <Button.ContextMenu>
                    <ContextMenu x:Name="ActionsMenu" Tag="no-ui-copy">
                        <MenuItem Header="Друк" Click="PrintClick"/>
                        <MenuItem Header="Зберегти в Excel" Click="ExcelClick"/>
                        <MenuItem Header="Видалити" Style="{StaticResource DangerMenuItem}" Click="DeleteClick"/>
                        <MenuItem Header="Закрити" Click="CloseClick"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DockPanel>
    </Grid>
</Window>
