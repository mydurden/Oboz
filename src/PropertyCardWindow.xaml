<Window x:Class="Obozny.PropertyCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Картка майна" Height="620" Width="860"
        MinHeight="440" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBox x:Name="TitleText" Style="{StaticResource CopyText}" FontSize="22" FontWeight="SemiBold"/>
                <TextBox x:Name="MetaText" Style="{StaticResource CopyText}" Margin="0,8,0,0"/>
                <TextBox x:Name="StockText" Style="{StaticResource CopyText}" Margin="0,2,0,0"/>
                <TextBox x:Name="ReservedText" Style="{StaticResource CopyText}" Margin="0,2,0,0" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="NomenclatureBtn" Style="{StaticResource IconButton}"
                    Width="52" Height="52" Margin="12,0,0,0" VerticalAlignment="Top"
                    Click="OpenNomenclatureClick"
                    ToolTip="Відкрити картку номенклатури">
                <Grid Width="28" Height="28">
                    <!-- Іконка «паспорт / довідник»: аркуш + рядок -->
                    <Border Background="{DynamicResource ButtonFg}" Opacity="0.92"
                            CornerRadius="3" Margin="4,2,2,2"/>
                    <Border Background="{DynamicResource Accent}" CornerRadius="2"
                            Width="14" Height="3" Margin="0,8,0,0" HorizontalAlignment="Center"
                            VerticalAlignment="Top"/>
                    <Border Background="{DynamicResource Accent}" CornerRadius="2"
                            Width="10" Height="3" Margin="0,14,0,0" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Opacity="0.85"/>
                </Grid>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,12" MaxWidth="360" HorizontalAlignment="Left">
            <TextBlock Text="Служба забезпечення" FontSize="13"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <ComboBox x:Name="SupplyBox" MinHeight="44" FontSize="15"
                      SelectionChanged="SupplyChanged"
                      ToolTip="Служба забезпечення позиції для книги обліку (отримання по Накладній)."/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Документи / рух майна" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>

        <DataGrid x:Name="DocsGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  MouseDoubleClick="OpenSelectedDocument" LoadingRow="OnLoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="110"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Тип руху" Binding="{Binding MoveKind}" Width="160"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding DocumentNumber}" Width="140"
                                    ElementStyle="{StaticResource CellCenter}"/>
                <DataGridTextColumn Header="Кількість" Binding="{Binding QuantityText}" Width="*"
                                    ElementStyle="{StaticResource CellRight}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="4" Content="Закрити" Style="{StaticResource GhostButton}"
                HorizontalAlignment="Right" Width="140" Margin="0,16,0,0" Click="CloseClick"/>
    </Grid>
</Window>
