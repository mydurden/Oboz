<Window x:Class="Obozny.SummaryInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Зведена інформація"
        Width="520" SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBg}">
    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2"
            CornerRadius="12" Background="{DynamicResource CardBg}" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox Style="{StaticResource CopyText}" Text="Зведена інформація"
                     FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBox x:Name="ReservedCountText" Style="{StaticResource CopyText}" Margin="0,0,0,10"/>
                <TextBox x:Name="ReservedValueText" Style="{StaticResource CopyText}" Margin="0,0,0,10"/>
                <TextBox x:Name="DraftCountText" Style="{StaticResource CopyText}"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource DraftBg}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
                <TextBox Style="{StaticResource CopyText}" FontSize="14"
                         Text="Не забудьте провести ці документи, тому що майно, яке зарезервоване не відображається у загальному переліку залишків!"/>
            </Border>

            <Button Grid.Row="3" Content="Зрозуміло"
                    MinHeight="40" MinWidth="160"
                    HorizontalAlignment="Center"
                    Click="OkClick"/>
        </Grid>
    </Border>
</Window>
