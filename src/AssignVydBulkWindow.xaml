<Window x:Class="Obozny.AssignVydBulkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Призначити Вид"
        Width="820" MinWidth="680"
        Height="600" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Скасувати" Style="{StaticResource GhostButton}"
                    MinWidth="140" MinHeight="44" Margin="0,0,8,0" Click="CancelClick"/>
            <Button Content="Зберегти" MinWidth="140" MinHeight="44" Click="SaveClick"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBox x:Name="TitleBlock" Style="{StaticResource CopyText}"
                     Text="Призначити Вид" FontSize="22" FontWeight="SemiBold"
                     Margin="0,0,0,8"/>
            <TextBlock x:Name="SummaryText" FontSize="14" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
            <TextBlock FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                       Text="Достатньо натиснути рядок (або галочку), щоб обрати чи зняти. Один Вид зверху — для обраних. Без галочок «Зберегти» і «Скасувати» — без змін."/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="ModeByName"
                             Content="Лише за назвою"
                             GroupName="VydBulkMode"
                             IsChecked="True"
                             FontSize="14"
                             MinHeight="40"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             Margin="0,0,20,0"
                             Checked="ModeChanged"/>
                <RadioButton x:Name="ModeAllWithout"
                             Content="Усі без Виду"
                             GroupName="VydBulkMode"
                             FontSize="14"
                             MinHeight="40"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="ModeChanged"/>
            </StackPanel>

            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Обрати всі" Style="{StaticResource GhostButton}"
                            MinWidth="130" MinHeight="40" Margin="0,0,8,0"
                            Click="SelectAllClick"/>
                    <Button Content="Зняти всі" Style="{StaticResource GhostButton}"
                            MinWidth="130" MinHeight="40"
                            Click="ClearAllClick"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="Вид для обраних" FontSize="13"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <!-- Один ComboBox на вікно — не сотні в рядках (фікс #2). -->
            <ComboBox x:Name="VydForAllBox" MinHeight="44" FontSize="16"
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <Border BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                Background="{DynamicResource CardBg}" Padding="4" CornerRadius="8">
            <DataGrid x:Name="RowsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.CanContentScroll="True"
                      MinRowHeight="44"
                      PreviewMouseLeftButtonDown="RowsGridRowClick"
                      PreviewTouchDown="RowsGridTouchDown">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="48" IsReadOnly="False"/>
                    <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="3*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellLeft}"/>
                    <DataGridTextColumn Header="О.В." Binding="{Binding Unit}" Width="72"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellCenter}"/>
                    <DataGridTextColumn Header="Тип майна" Binding="{Binding KindText}" Width="140"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellLeft}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
