<Window x:Class="Obozny.SummaryStatementViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Узагальнююча відомість (Додаток 1)"
        Height="640" Width="980"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBox x:Name="TitleText" Style="{StaticResource CopyText}"
                     FontSize="22" FontWeight="SemiBold"/>
            <TextBox x:Name="InfoText" Style="{StaticResource CopyText}" Margin="0,8,0,0"
                     Foreground="{DynamicResource Muted}"/>
        </StackPanel>

        <DataGrid x:Name="LinesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  CanUserResizeRows="False" SelectionMode="Single"/>

        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button Content="Закрити" Style="{StaticResource GhostButton}"
                    DockPanel.Dock="Left"
                    MinWidth="140" MinHeight="44" Height="44"
                    IsCancel="True" Click="CloseClick"/>
            <Button Content="Зберегти в Excel" Style="{StaticResource GhostButton}"
                    DockPanel.Dock="Right"
                    MinWidth="180" MinHeight="44" Height="44"
                    HorizontalAlignment="Right"
                    Click="ExcelClick"/>
        </DockPanel>
    </Grid>
</Window>
