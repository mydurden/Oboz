<Window x:Class="Obozny.DocHeaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підготувати документ" Height="560" Width="560"
        MinHeight="440" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="DocTypeText" FontSize="20" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="WorkTypeText" FontSize="14"
                       Foreground="{DynamicResource Muted}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>
        </StackPanel>

        <!-- Звичайний документ: одне поле номера -->
        <StackPanel x:Name="SingleNumberPanel" Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Номер документа" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="NumberBox" MinHeight="40" Margin="0,0,0,4"/>
            <TextBlock Text="Залиште порожнім для безномерного документа (б/н)"
                       FontSize="12" Foreground="{DynamicResource Muted}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ЯС/ЗЯС + ВР: спочатку Акт ВР, потім основний акт -->
        <StackPanel x:Name="YasVrNumberPanel" Grid.Row="1" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock Text="Акт виконаних робіт" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="VrNumberBox" MinHeight="40" Margin="0,0,0,4"
                     ToolTip="Порожньо — у документах буде «н/д» (не вигадується)."/>
            <TextBlock Text="Порожньо — у документі буде «н/д»"
                       FontSize="12" Foreground="{DynamicResource Muted}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock x:Name="PairedMainNumberLabel" Text="Акт якісного стану" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="YasNumberBox" MinHeight="40" Margin="0,0,0,4"/>
            <TextBlock Text="Залиште порожнім для безномерного документа (б/н)"
                       FontSize="12" Foreground="{DynamicResource Muted}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Дата документа" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextPrimary}"/>
            <DatePicker x:Name="DateBox" FontSize="16" HorizontalAlignment="Left" Width="220"
                        MinHeight="40"/>
        </StackPanel>

        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Top" Text="Примітка" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="NoteBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     MinHeight="96"
                     Padding="8,8"/>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Скасувати" Style="{StaticResource GhostButton}"
                    MinWidth="140" MinHeight="44" Click="Cancel" Margin="0,0,8,0"/>
            <Button Content="Підготувати" MinWidth="160" MinHeight="44" Click="Ok"/>
        </StackPanel>
    </Grid>
</Window>
